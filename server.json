{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.oneill9/mcp-server-tfl",
  "description": "Community-built server providing real-time London transport data via the TfL Unified API",
  "icon": "https://raw.githubusercontent.com/oneill9/mcp-server-tfl/main/docs/logo.svg",
  "repository": {
    "url": "https://github.com/oneill9/mcp-server-tfl",
    "source": "github"
  },
  "version": "1.3.0",
  "privacy_policies": [
    "https://raw.githubusercontent.com/oneill9/mcp-server-tfl/main/PRIVACY.md"
  ],
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/oneill9/mcp-server-tfl:1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TFL_APP_KEY",
          "description": "TfL API key — optional, but raises rate limits. Register at https://api-portal.tfl.gov.uk/",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/oneill9/mcp-server-tfl/releases/download/v1.3.0/tfl.mcpb",
      "transport": {
        "type": "stdio"
      },
      "sha256": "03d2d4b2b237bf29408750ef73c621d86918e22f93e280cfadccee89e1b02a31",
      "fileSha256": "04941ff1c0500bc75bfc2b8af05f18f2149672ec7704fc52f4eac249df25d736"
    }
  ]
}
